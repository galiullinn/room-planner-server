# App
APP_TITLE="Room Planner API"
APP_DEBUG=false
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]

# Database
DB_USER=db_user
DB_PASS=db_pass
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db_name
DB_ECHO=false

# Auth
JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7